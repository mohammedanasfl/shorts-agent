# Copy to .env and fill in your own keys. .env is gitignored.

# Groq — powers the research/script LLMs (qwen), Orpheus TTS (audio),
# and whisper-large-v3-turbo STT (captions). https://console.groq.com/keys
GROQ_API_KEY=

# Tavily — web search tool used by the research stage. https://app.tavily.com
TAVILY_API_KEY=
